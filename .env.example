# API Base URL
VITE_API_BASE_URL=

# OAuth2 public client ID (required for password login)
VITE_OAUTH_CLIENT_ID=

# Legacy only: every VITE_* value is visible in the browser bundle.
# Prefer a public OAuth client/PKCE flow and leave this empty.
VITE_OAUTH_CLIENT_SECRET=

# Plate Recognizer API Token (Optional / Mock Fallback available)
VITE_PLATE_RECOGNIZER_TOKEN=

# Mock Mode (Set to true to use offline mock handlers)
VITE_USE_MOCK_API=false
